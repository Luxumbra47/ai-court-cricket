{
  "name": "ai-court-cricket",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:https": "node scripts/dev-tls.mjs && cross-env LOCAL_TLS=true npm run dev",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:mysql": "vitest run tests/database.test.ts",
    "test:tls": "node scripts/verify-local-tls.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "play": "node scripts/start-local.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "prisma": "6.12.0",
    "selfsigned": "^3.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "5.0.5"
  }
}
