# No player keys belong here. Copy to .env for optional server settings.
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
# Enable only behind the trusted loopback HTTPS proxy; dev:https sets this automatically.
TRUST_PROXY=false
LLM_TIMEOUT_MS=12000
DAILY_BUDGET=10
UNKNOWN_CALL_RESERVE=0.10
DAILY_CALL_LIMIT=200
# Optional exact hostname allowlist for the existing service provider presets.
LLM_ALLOWED_HOSTS=
