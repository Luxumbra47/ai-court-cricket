# No player keys belong here. Copy this file to .env for server settings.
PORT=3001
HOST=127.0.0.1
# memory = no persistence (playable offline); mysql = require database at startup
STORAGE_MODE=memory
DATABASE_URL="mysql://court:CHANGE_ME@127.0.0.1:3306/ai_court"
# Explicit allowed browser origins. Add LAN HTTPS origin when playing with a friend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
TRUST_PROXY=false
# Room is cancelled after this many minutes without a committed action or room operation.
ROOM_TTL_MINUTES=30
LLM_TIMEOUT_MS=12000
DAILY_BUDGET=10
UNKNOWN_CALL_RESERVE=0.10
DAILY_CALL_LIMIT=200
# Optional exact hostname allowlist to further restrict supported official domestic endpoints.
LLM_ALLOWED_HOSTS=
